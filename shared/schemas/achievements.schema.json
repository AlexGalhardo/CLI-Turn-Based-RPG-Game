{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "achievements.schema.json",
	"title": "achievements",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"achievements": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
					},
					"type": {
						"type": "string",
						"pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
					},
					"value": {
						"type": "integer",
						"minimum": 0
					}
				},
				"required": ["id", "type", "value"]
			}
		}
	},
	"required": ["achievements"]
}
