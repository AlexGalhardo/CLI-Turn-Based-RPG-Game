{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "families.schema.json",
	"title": "families",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"families": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
			}
		}
	},
	"required": ["families"]
}
