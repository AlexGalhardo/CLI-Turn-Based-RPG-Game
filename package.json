{
  "name": "cli-turn-based-rpg-game",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo tooling (Biome, commitlint, husky) for the CLI Turn-Based RPG in Python, TypeScript and Go",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "format": "biome format --write .",
    "format:ci": "biome format .",
    "lint": "biome check --write .",
    "lint:ci": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,jsonc}": "biome check --write --no-errors-on-unmatched",
    "rpg-python/**/*.py": ["uv run --project rpg-python ruff format", "uv run --project rpg-python ruff check --fix"],
    "rpg-golang/**/*.go": "gofmt -w"
  }
}
