root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# A spec do YAML proíbe tab para indentação.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Espaços no fim da linha são quebra de linha forçada em Markdown.
[*.md]
trim_trailing_whitespace = false

# package.json é reescrito pelo Bun/npm com 2 espaços; forçar tab geraria diff a cada install.
[package.json]
indent_style = space
indent_size = 2

[*.lock]
insert_final_newline = unset
trim_trailing_whitespace = unset
