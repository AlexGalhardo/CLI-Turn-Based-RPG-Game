{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"]
	},
	"include": ["src", "tests"]
}
