# Generates a C source that embeds the game's Lua modules and shared/{data,i18n,art} into the binary.
# Usage: cmake -DSOURCE_DIR=<rpg-lua>/src -DSHARED_DIR=<repo>/shared -DOUTPUT=<file>.c -P embed.cmake
#
# Each file becomes a `static const unsigned char[]` initialised byte by byte. String literals would be shorter, but
# C only guarantees 4095 characters per literal and has no raw strings; byte arrays have neither problem.

if(NOT SOURCE_DIR OR NOT SHARED_DIR OR NOT OUTPUT)
	message(FATAL_ERROR "SOURCE_DIR, SHARED_DIR and OUTPUT are required")
endif()

set(arrays "")
set(index 0)

# Appends one array per file to `arrays` and one row per file to the table named by `table_variable`.
function(embed root table_variable)
	set(table "")
	foreach(relative IN LISTS ARGN)
		file(READ "${root}/${relative}" hex HEX)
		string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
		# Line endings are normalised so a CRLF checkout embeds exactly the same bytes as an LF one.
		string(REPLACE "0x0d,0x0a," "0x0a," bytes "${bytes}")
		string(REPLACE "0x0a," "0x0a,\n" bytes "${bytes}")
		string(APPEND arrays "static const unsigned char FILE_${index}[] = {\n${bytes}0x00};\n\n")
		set(name "${relative}")
		if(table_variable STREQUAL "modules")
			# rpg/domain/rng.lua is the module rpg.domain.rng
			string(REGEX REPLACE "\\.lua$" "" name "${name}")
			string(REPLACE "/" "." name "${name}")
		endif()
		string(APPEND table "\t{\"${name}\", (const char *)FILE_${index}, sizeof(FILE_${index}) - 1},\n")
		math(EXPR index "${index} + 1")
	endforeach()
	set(arrays "${arrays}" PARENT_SCOPE)
	set(index "${index}" PARENT_SCOPE)
	set(${table_variable} "${table}" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE lua_files RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/rpg/*.lua")
list(SORT lua_files)
embed("${SOURCE_DIR}" modules ${lua_files})

file(GLOB_RECURSE shared_files RELATIVE "${SHARED_DIR}"
	"${SHARED_DIR}/data/*.json" "${SHARED_DIR}/i18n/*.json" "${SHARED_DIR}/art/*.txt")
list(SORT shared_files)
embed("${SHARED_DIR}" assets ${shared_files})

set(source "// Generated by cmake/embed.cmake from src/ and shared/ — do not edit.
#include \"embedded.h\"

${arrays}const EmbeddedFile EMBEDDED_MODULES[] = {
${modules}};

const size_t EMBEDDED_MODULE_COUNT = sizeof(EMBEDDED_MODULES) / sizeof(EMBEDDED_MODULES[0]);

const EmbeddedFile EMBEDDED_ASSETS[] = {
${assets}};

const size_t EMBEDDED_ASSET_COUNT = sizeof(EMBEDDED_ASSETS) / sizeof(EMBEDDED_ASSETS[0]);
")

# Only touch the file when the content changes, so unrelated rebuilds stay incremental.
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" previous)
	if(previous STREQUAL source)
		return()
	endif()
endif()
file(WRITE "${OUTPUT}" "${source}")
